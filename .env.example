# DIRIGERA Hub Configuration
# Get your hub IP from your router or use: ping -c 1 dirigera.local
DIRIGERA_HUB_IP=<YOUR_HUB_IP>
# Generate token: pip install dirigera && dirigera generate-token --ip <YOUR_HUB_IP>
DIRIGERA_TOKEN=<YOUR_ACCESS_TOKEN>

# Polling interval in minutes (how often to read power data)
POLL_INTERVAL_MINUTES=5

# API URL for dashboard to reach the collector
# Set to your server's IP for remote access (e.g., http://192.168.1.100:7352)
# This is configured at container startup - no rebuild needed when changing!
API_URL=http://localhost:7352
