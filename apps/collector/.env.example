# Database (SQLite) - path relative to prisma/schema.prisma
DATABASE_URL=file:../ikea_power.db

# DIRIGERA Hub Configuration
# Get your hub IP from your router or use: ping -c 1 dirigera.local
DIRIGERA_HUB_IP=<YOUR_HUB_IP>
# Generate token: pip install dirigera && dirigera generate-token --ip <YOUR_HUB_IP>
DIRIGERA_TOKEN=<YOUR_ACCESS_TOKEN>

# Collector settings
POLL_INTERVAL_MINUTES=5
PORT=3001
